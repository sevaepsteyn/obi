<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Feature 123: the mesh daemon — the ONE process that owns the Meshtastic serial port.
     ROLLOUT (operator-gated; see specs/123-mesh-daemon/quickstart.md):
       cp deploy/com.obi.mesh.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.obi.mesh.plist
     ProcessType Standard, NOT Background: launchd Background throttles subprocess I/O
     ~10x (the 088 lesson that bit com.obi.web and com.obi.slack). -->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/obi/src/obi/.venv/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.obi.mesh</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/obi/src/obi/.venv/bin/obi</string>
		<string>mesh</string>
		<string>daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/obi/.local/state/obi/mesh-daemon.log</string>
	<key>StandardOutPath</key>
	<string>/Users/obi/.local/state/obi/mesh-daemon.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>/Users/obi/src/obi</string>
</dict>
</plist>
